# ── Налаштування PostgreSQL ──
POSTGRES_USER=techops
POSTGRES_PASSWORD=techops_secret_pass
POSTGRES_DB=access_requests
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# ── Налаштування n8n (Webhooks) ──
N8N_PORT=5678
# Локальна адреса за замовчуванням (для тестів через localhost):
N8N_WEBHOOK_URL=http://localhost:5678/
# Для підключення реального Slack розкоментуйте і вкажіть ваш публічний HTTPS-домен або тунель (ngrok/Cloudflare):
# N8N_WEBHOOK_URL=https://your-slack-tunnel-or-domain.ngrok-free.app/

GENERIC_TIMEZONE=Europe/Kyiv

# ── Налаштування Google AI Studio (Gemini) ──
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Інтеграція зі Slack (відповіді бота та сповіщення) ──
# Bot User OAuth Token (xoxb-...) для публікації відповідей у Slack:
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../X...
# SLACK_CHANNEL_ALERTS=#alerts_channel
